{
  "schema_version": "1.0",
  "description": "Canonical test vectors for Story 05 (residue partitions & certificate schema). Each entry is either a certificate or a partition. Certificates test the strict parser and digest computation. Partitions test the partition checker (valid, incomplete, non-disjoint, invalid).",
  "vectors": [
    {
      "name": "fixed_point_1",
      "type": "certificate",
      "certificate": {
        "schema_version": "1.0",
        "start": 1,
        "steps": 1,
        "target": 1
      },
      "comment": "T(1) = 1 (fixed point)."
    },
    {
      "name": "trajectory_27_to_91",
      "type": "certificate",
      "certificate": {
        "schema_version": "1.0",
        "start": 27,
        "steps": 8,
        "target": 91
      },
      "comment": "8-step accelerated trajectory from 27 to 91 (matches Story 04 corpus)."
    },
    {
      "name": "partition_valid_trivial_3",
      "type": "partition",
      "modulus": 3,
      "residues": [0, 1, 2],
      "expected_valid": true,
      "comment": "Trivial partition of Z/3Z."
    },
    {
      "name": "partition_valid_reorder_4",
      "type": "partition",
      "modulus": 4,
      "residues": [3, 1, 0, 2],
      "expected_valid": true,
      "comment": "Reordered partition of Z/4Z (order does not matter)."
    },
    {
      "name": "partition_singleton_1",
      "type": "partition",
      "modulus": 1,
      "residues": [0],
      "expected_valid": true,
      "comment": "Trivial partition of Z/1Z (singleton)."
    },
    {
      "name": "partition_incomplete_3",
      "type": "partition",
      "modulus": 3,
      "residues": [0, 1],
      "expected_valid": false,
      "expected_error": "INCOMPLETE",
      "comment": "Gapped partition (missing 2)."
    },
    {
      "name": "partition_non_disjoint_3",
      "type": "partition",
      "modulus": 3,
      "residues": [0, 1, 1],
      "expected_valid": false,
      "expected_error": "NON_DISJOINT",
      "comment": "Overlapping partition (1 appears twice)."
    },
    {
      "name": "partition_invalid_residue_3",
      "type": "partition",
      "modulus": 3,
      "residues": [0, 1, -1],
      "expected_valid": false,
      "expected_error": "INVALID_RESIDUE",
      "comment": "Negative residue."
    },
    {
      "name": "partition_out_of_range_3",
      "type": "partition",
      "modulus": 3,
      "residues": [0, 1, 3],
      "expected_valid": false,
      "expected_error": "INVALID_RESIDUE",
      "comment": "Residue 3 is out of range [0, 3)."
    }
  ]
}
